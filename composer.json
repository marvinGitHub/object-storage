{
  "name": "melia/object-storage",
  "description": "File-based object store for PHP: whole object graphs by UUID in plain files, lazy loading, crash-safe writes, locking, unique and search indexes, an SQL-like query language (OQL, experimental), a CLI and a viewer.",
  "license": "Apache-2.0",
  "type": "library",
  "keywords": [
    "php",
    "object-storage",
    "object store",
    "persistence",
    "file-based",
    "json",
    "uuid",
    "lazy-loading",
    "references",
    "circular references",
    "object-graph",
    "locking",
    "concurrency",
    "cache",
    "metadata",
    "ttl",
    "expiration",
    "stubs",
    "serializer",
    "deserializer",
    "storage",
    "data-store",
    "snapshot",
    "event-driven",
    "index",
    "unique-index",
    "full-text-search",
    "query-language",
    "oql",
    "php8"
  ],
  "authors": [
    {
      "name": "marvin-elia.hoppe",
      "email": "marvin_elia@web.de",
      "role": "lead"
    }
  ],
  "autoload": {
    "psr-4": {
      "melia\\ObjectStorage\\": "src/melia/ObjectStorage",
      "Tests\\melia\\ObjectStorage\\": "tests/melia/ObjectStorage"
    }
  },
  "bin": [
    "bin/object-storage"
  ],
  "scripts": {
    "test": [
      "@composer install",
      "vendor/bin/phpunit --display-deprecations"
    ],
    "analyze": [
      "@composer install",
      "vendor/bin/phpstan analyse"
    ],
    "profile": [
      "@composer install",
      "php profiling/operations.php"
    ],
    "measure": [
      "@composer install",
      "PROFILE=0 php profiling/operations.php"
    ],
    "coverage": [
      "@composer install",
      "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-text --coverage-filter src"
    ]
  },
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "symfony/console": "^8.0",
    "psr/simple-cache": "^3.0",
    "symfony/cache": "^8.0",
    "symfony/lock": "^8.0"
  },
  "require-dev": {
    "ext-xdebug": "*",
    "twig/twig": "^3.30",
    "fakerphp/faker": "^1.24",
    "phpstan/phpstan": "^2.3",
    "perftools/php-profiler": "^1.4",
    "monolog/monolog": "^3.0",
    "phpunit/phpunit": "^13.0",
    "loupe/loupe": "^1.1"
  },
  "suggest": {
    "ext-memcached": "For caching operations",
    "ext-redis": "For caching operations",
    "ext-apcu": "For caching operations",
    "loupe/loupe": "For the Loupe search engine (melia\\ObjectStorage\\Search\\Loupe\\LoupeEngine); needs ext-intl and ext-pdo_sqlite"
  }
}
